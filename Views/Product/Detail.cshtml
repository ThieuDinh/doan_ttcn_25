@model doan_ttcn.ViewModels.ProductDetailVM
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
   
}

@section Styles {
    <link href="~/css/product-detail.css" rel="stylesheet">
}

<div class="page-header text-center">
    <h1 class="font-display font-weight-bold">Chi tiết sản phẩm</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb justify-content-center bg-transparent p-0">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Product" class="text-muted">Sản phẩm</a></li>
            <li class="breadcrumb-item active text-primary" aria-current="page">Chi tiết</li>
        </ol>
    </nav>
</div>

<div class="container py-5">
    <div class="row">

        <div class="col-lg-12 mb-5">
            <div class="row mb-5">
                <div class="col-lg-6 mb-4">
                    <div class="product-image">
                        <img src="~/product/@Model.ImgUrl" class="img-fluid w-100"
                            alt="Product">
                    </div>
                </div>
                <div class="col-lg-6">
                    <h3 class="font-display font-weight-bold">@Model.Name</h3>
                    <p class="text-muted mb-3">Danh mục: <span class="text-primary">@Model.CategoryName</span></p>
                    <h4 class="product-price mb-3">@Model.Price.ToString("N0") </h4>

                    <div class="star-rating mb-3">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </div>

                    <p class="mb-4 text-secondary">@Model.Description
                    </p>

                    <div class="d-flex align-items-center mb-4">
                        <div class="input-group quantity-input-group mr-3">
                            <div class="input-group-prepend">
                                <button class="btn btn-spinner" type="button"><i class="fa fa-minus small"></i></button>
                            </div>
                            <input type="text" class="form-control text-center border-left-0 border-right-0" value="1">
                            <div class="input-group-append">
                                <button class="btn btn-spinner" type="button"><i class="fa fa-plus small" ></i></button>
                            </div>
                        </div>
                        <button class="btn btn-outline-primary rounded-pill px-4 font-weight-bold">
                            <i class="fa fa-shopping-bag mr-2"></i> Thêm vào giỏ
                        </button>
                    </div>
                </div>
            </div>

            <div class="mb-5">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="desc-tab" data-toggle="tab" href="#desc"
                            role="tab">Description</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="review-tab" data-toggle="tab" href="#review" role="tab">Reviews (2)</a>
                    </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="desc" role="tabpanel">
                        <p>The generated Lorem Ipsum is therefore always free from repetition injected humour, or
                            non-characteristic words etc. Susp endisse ultricies nisi vel quam suscipit.</p>

                        <div class="row mt-4">
                            <div class="col-md-6">
                                <ul class="list-group list-group-flush">
                                    <li
                                        class="list-group-item d-flex justify-content-between align-items-center bg-light border-0 mb-1">
                                        <span>Weight</span> <span class="font-weight-bold">1 kg</span>
                                    </li>
                                    <li
                                        class="list-group-item d-flex justify-content-between align-items-center border-0 mb-1">
                                        <span>Country of Origin</span> <span class="font-weight-bold">Agro Farm</span>
                                    </li>
                                    <li
                                        class="list-group-item d-flex justify-content-between align-items-center bg-light border-0 mb-1">
                                        <span>Quality</span> <span class="font-weight-bold">Organic</span>
                                    </li>
                                    <li
                                        class="list-group-item d-flex justify-content-between align-items-center border-0 mb-1">
                                        <span>Check</span> <span class="font-weight-bold">Healthy</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="review" role="tabpanel">
                        <div class="media mb-4">
                            <img class="review-avatar mr-3" src="https://via.placeholder.com/100" alt="Avatar">
                            <div class="media-body">
                                <div class="d-flex justify-content-between">
                                    <h5 class="mt-0 font-weight-bold">Jason Smith</h5>
                                    <div class="star-rating">
                                        <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i
                                            class="fa fa-star"></i><i class="fa fa-star empty"></i>
                                    </div>
                                </div>
                                <p class="text-muted small">April 12, 2024</p>
                                <p>The generated Lorem Ipsum is therefore always free from repetition injected humour,
                                    or non-characteristic words etc.</p>
                            </div>
                        </div>

                        <div class="media mb-5">
                            <img class="review-avatar mr-3" src="https://via.placeholder.com/100" alt="Avatar">
                            <div class="media-body">
                                <div class="d-flex justify-content-between">
                                    <h5 class="mt-0 font-weight-bold">Sam Peters</h5>
                                    <div class="star-rating">
                                        <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i
                                            class="fa fa-star"></i><i class="fa fa-star"></i>
                                    </div>
                                </div>
                                <p class="text-muted small">April 12, 2024</p>
                                <p>Susp endisse ultricies nisi vel quam suscipit.</p>
                            </div>
                        </div>

                        <h4 class="font-display font-weight-bold mb-4">Leave a Reply</h4>
                        <form>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <input type="text" class="form-control" placeholder="Your Name *">
                                </div>
                                <div class="form-group col-md-6">
                                    <input type="email" class="form-control" placeholder="Your Email *">
                                </div>
                            </div>
                            <div class="form-group">
                                <textarea class="form-control" rows="5" placeholder="Your Review *"></textarea>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="star-rating">
                                    <span class="mr-2 text-muted">Please rate:</span>
                                    <i class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i
                                        class="fa fa-star-o"></i><i class="fa fa-star-o"></i><i
                                        class="fa fa-star-o"></i>
                                </div>
                                <button type="submit" class="btn btn-outline-primary rounded-pill px-4">Post
                                    Comment</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <h3 class="font-display font-weight-bold mb-4">Related products</h3>
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="card card-product h-100 border-0">
                        <div class="badge badge-primary badge-type">Vegetable</div>
                        <img class="card-img-top" src="https://via.placeholder.com/300x200?text=Parsley" alt="Product">
                        <div class="card-body text-center">
                            <h5 class="card-title font-weight-bold">Parsely</h5>
                            <p class="card-text text-muted small">Lorem ipsum dolor sit amet.</p>
                            <h6 class="font-weight-bold text-dark">$4.99 / kg</h6>
                            <button class="btn btn-outline-primary btn-sm rounded-pill mt-2"><i
                                    class="fa fa-shopping-bag mr-1"></i> Add to cart</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card card-product h-100 border-0">
                        <div class="badge badge-primary badge-type">Vegetable</div>
                        <img class="card-img-top" src="https://via.placeholder.com/300x200?text=Banana" alt="Product">
                        <div class="card-body text-center">
                            <h5 class="card-title font-weight-bold">Banana</h5>
                            <p class="card-text text-muted small">Lorem ipsum dolor sit amet.</p>
                            <h6 class="font-weight-bold text-dark">$7.99 / kg</h6>
                            <button class="btn btn-outline-primary btn-sm rounded-pill mt-2"><i
                                    class="fa fa-shopping-bag mr-1"></i> Add to cart</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card card-product h-100 border-0">
                        <div class="badge badge-primary badge-type">Vegetable</div>
                        <img class="card-img-top" src="https://via.placeholder.com/300x200?text=Potatoes" alt="Product">
                        <div class="card-body text-center">
                            <h5 class="card-title font-weight-bold">Potatoes</h5>
                            <p class="card-text text-muted small">Lorem ipsum dolor sit amet.</p>
                            <h6 class="font-weight-bold text-dark">$7.99 / kg</h6>
                            <button class="btn btn-outline-primary btn-sm rounded-pill mt-2"><i
                                    class="fa fa-shopping-bag mr-1"></i> Add to cart</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
    integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
    crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js"
    integrity="sha384-cs/chFZiN24E4KMATLdqdvsezGxaGsi4hLGOzlXwp5UZB1LY//20VyM2taTB4QvJ"
    crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js"
    integrity="sha384-uefMccjFJAIv6A+rW+L4AHf99KvxDjWSu1z9VI8SKNVmz4sk7buKt/6v9KI65qnm"
    crossorigin="anonymous"></script>
@model doan_ttcn.ViewModels.ProductDetailVM
@{
    ViewData["Title"] = "Chi tiết sản phẩm";

}

@section Styles {
    <link href="~/css/product-detail.css" rel="stylesheet">
}

<div class="page-header text-center">
    <h1 class="font-display font-weight-bold">Chi tiết sản phẩm</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb justify-content-center bg-transparent p-0">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-muted">Trang chủ</a>
            </li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Product" class="text-muted">Sản phẩm</a>
            </li>
            <li class="breadcrumb-item active text-primary" aria-current="page">Chi tiết</li>
        </ol>
    </nav>
</div>

<div class="container py-5">
    <div class="row">

        <div class="col-lg-12 mb-5">
            <div class="row mb-5">
                <div class="col-lg-6 mb-4">
                    <div class="product-image">
                        <img src="~/product/@Model.ImgUrl" class="img-fluid w-100" alt="Product">
                    </div>
                </div>
                <div class="col-lg-6">
                    <h3 class="font-display font-weight-bold">@Model.Name</h3>
                    <p class="text-muted mb-3">Danh mục: <span class="text-primary">@Model.CategoryName</span></p>
                    <h4 class="product-price mb-3">@Model.Price.ToString("N0") </h4>

                    <div class="star-rating mb-3">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </div>

                    <p class="mb-4 text-secondary">@Model.Description
                    </p>

                    <form asp-controller="Cart" asp-action="addToCart" method="post"
                        class="d-flex align-items-center mb-4">
                        <input type="hidden" name="Id" value="@Model.Id" />

                        <div class="input-group quantity-input-group mr-3" style="width: 130px;">
                            <div class="input-group-prepend">
                                <button class="btn btn-spinner" type="button" onclick="decreaseQuantity()">
                                    <i class="fa fa-minus small"></i>
                                </button>
                            </div>
                            <input type="number" name="quantity" id="quantityInput"
                                class="form-control text-center border-left-0 border-right-0" value="1" min="1"
                                readonly>
                            <div class="input-group-append">
                                <button class="btn btn-spinner" type="button" onclick="increaseQuantity()">
                                    <i class="fa fa-plus small"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-outline-primary rounded-pill px-4 font-weight-bold">
                            <i class="fa fa-shopping-bag mr-2"></i> Thêm vào giỏ
                        </button>
                    </form>
                </div>
            </div>

            <div class="mb-5">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="desc-tab" data-toggle="tab" href="#desc" role="tab">Mô tả</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="review-tab" data-toggle="tab" href="#review" role="tab">Đánh giá</a>
                    </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="desc" role="tabpanel">
                        <p>@Model.Description</p>

                        
                    </div>

                    <div class="tab-pane fade" id="review" role="tabpanel">
                        @if (Model.Reviews != null && Model.Reviews.Any())
                        {
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="media mb-4 border-bottom pb-3">


                                    <div class="media-body">
                                        <div class="d-flex justify-content-between">
                                            <h5 class="mt-0 font-weight-bold">
                                                @(review.User?.FullName ?? "Người dùng ẩn danh")
                                            </h5>

                                            <div class="star-rating text-warning">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="fa fa-star"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-star-o text-muted"></i>
                                                    }
                                                }
                                            </div>
                                        </div>

                                        <p class="text-muted small">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                        <p>@review.Content</p>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>


        </div>


    </div>
</div>
<script>
    function increaseQuantity() {
        var input = document.getElementById('quantityInput');
        var value = parseInt(input.value);
        input.value = value + 1;
    }

    function decreaseQuantity() {
        var input = document.getElementById('quantityInput');
        var value = parseInt(input.value);
        if (value > 1) {
            input.value = value - 1;
        }
    }
</script>
<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
    integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
    crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js"
    integrity="sha384-cs/chFZiN24E4KMATLdqdvsezGxaGsi4hLGOzlXwp5UZB1LY//20VyM2taTB4QvJ"
    crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js"
    integrity="sha384-uefMccjFJAIv6A+rW+L4AHf99KvxDjWSu1z9VI8SKNVmz4sk7buKt/6v9KI65qnm"
    crossorigin="anonymous"></script>
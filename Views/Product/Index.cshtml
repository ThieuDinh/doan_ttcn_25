@model IEnumerable<doan_ttcn.ViewModels.ProductVM>
@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <style>
        body {
            font-family: "Roboto", sans-serif;
            background-color: #f7f7f7;
            color: #333;
        }

        .font-display {
            font-family: "Work Sans", sans-serif;
        }
        .text-primary { color: #4CAF50 !important; }
      .bg-primary { background-color: #4CAF50 !important; }
      .btn-primary { 
        background-color: #4CAF50; 
        border-color: #4CAF50; 
      }
      .btn-primary:hover {
        background-color: #43a047;
        border-color: #43a047;
      }
    </style>
    <link rel="stylesheet" href="~/css/product.css">
}


<div class="page-header text-center">
    <h1 class="font-display font-weight-bold">Sản phẩm</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb justify-content-center bg-transparent p-0">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-muted">Trang chủ</a>
            </li>

            <li class="breadcrumb-item active text-primary" aria-current="page">Sản phẩm</li>
        </ol>
    </nav>
</div>

<main class="container py-5 ">
    <div class="row">

        <aside class="col-lg-3 mb-5">
            <div class="mb-5">
                @await Component.InvokeAsync("CategoryMenu")

            </div>
        </aside>

        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div class="input-group">
                    <form asp-controller="Product" asp-action="Search" class="form-inline" method="get">
                        <input type="search" class="form-control" name="query" placeholder="tìm kiếm sản phẩm"
                            aria-describedby="search-icon-1"  value="@ViewBag.Keyword"> 
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary" type="submit" id="search-icon-1">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                
            </div>

            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-xl-4 mb-4">
                        <div class="card product-card h-100 border-0">
                            <div class="product-img-wrapper" style="height: 300px;">
                                <a asp-action="Detail" asp-controller="Product" asp-route-id="@item.Id">
                                    <img class="card-img-top h-100" style="object-fit: cover;" src="~/product/@item.ImgUrl"
                                        alt="@item.Name"></a>
                                <div class="hover-overlay">
                                    <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.Id">
                                        <button class="btn rounded-pill px-4 add-to-cart-btn">Thêm vào
                                            giỏ</button></a>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <a asp-action="Detail" asp-controller="Product" asp-route-id="@item.Id">
                                    <h5 class="card-title font-display font-weight-bold h6 text-dark">@item.Name</h5>
                                </a>
                                <p class="card-text text-primary font-weight-bold">@item.Price đ</p>
                            </div>
                        </div>
                    </div>

                }



            </div>
           

        </div>
    </div>
</main>
@model IEnumerable<doan_ttcn.Models.ViewModels.ProductViewModels>
@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link rel="stylesheet" href="/css/product.css">
}


    <div class="bg-light py-5 text-center border-bottom mt-5 " >
        <div class="container">
     
            <h1 class="font-display font-weight-bold display-4 text-dark">Sản phẩm</h1>
            
        </div>
    </div>

    <main class="container py-5">
        <div class="row">

            <aside class="col-lg-3 mb-5">
                <div class="mb-5">
                @await Component.InvokeAsync("CategoryMenu")
                    
                </div>

                <div class="mb-5">
                    <h3 class="font-display h5 font-weight-bold mb-3 border-bottom pb-2">Lọc theo giá</h3>
                    <form>
                        <div class="form-group">
                            <input type="range" class="custom-range" min="0" max="100" id="customRange1">
                            <div class="d-flex justify-content-between text-muted small mt-2">
                                <span>0₫</span>
                                <span>999,000₫</span>
                            </div>
                        </div>
                        <button class="btn btn-primary btn-block btn-sm font-weight-bold">Lọc</button>
                    </form>
                </div>

                <div>
                    <h3 class="font-display h5 font-weight-bold mb-3 border-bottom pb-2">Đánh giá cao</h3>

                    <div class="media mb-3">
                        <img class="mr-3 small-product-img"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuD_vam1fkVVuHKbwn3SDLBxYpFbdwkNPJSqcsHqA1XAg4GfivqXwcgmNbAA7R6SxsZL51k5Khb9W6CcTR9wfj7_WIh1Pn7SNbN59-_EFsNoaFAYXaxv37yMo0LBR0IkNEV-F2wX7oKidqTWGPIIEOMZ3971c0JftYAjES6TqEJB9cDpaN7ubr6yfvlhw7UQc0eA0R8j_dx1wsVJXCnLaSpVXEekFcWhQthDJRS0XwZLYp3wXu2kD3e5VVnl2Nd4frRz-6slNqA85LQ"
                            alt="Fresh Strawberries">
                        <div class="media-body">
                            <h6 class="mt-0 mb-1 text-dark font-weight-bold">Fresh Strawberries</h6>
                            <p class="text-primary font-weight-bold mb-0">$12.00</p>
                        </div>
                    </div>

                    <div class="media mb-3">
                        <img class="mr-3 small-product-img"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCEvjHctirqE-9X85jxJz4hwoMAB55Ld892gE8NYJVY0SIUZAFcBx3jWBi1QAYUwVmfDwI81c8MR0yIrpx5dYN6m6otyx--6IgdQP4v0QBl3-79QdYDz2WrN1Ww2kynLR1luU5bJVo36qMR6d-vXyga84qYKD0Az6e0_7RabjkoiOpjPo_O_9rwo8TMUCRZPugly1NDMtI5t_N0Al_nZ_U8sz3tDxc0ZaR2nsLVrkY8taZ92sCnobsKvWu_lBH69hCWEJe-b-Di8_A"
                            alt="Organic Apples">
                        <div class="media-body">
                            <h6 class="mt-0 mb-1 text-dark font-weight-bold">Organic Apples</h6>
                            <p class="text-primary font-weight-bold mb-0">$8.50</p>
                        </div>
                    </div>

                    <div class="media mb-3">
                        <img class="mr-3 small-product-img"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBPqEfNsw6UJjgQRbtM89jhy3ytfIZwG0oVRmyTdSrlwbK2NahBD8YNB89l1m_yesoeaDvJ1Z26x0YqT8NjFfO0N2pXAZctZoUKsnmltKTB-xMOAwn6LlLixnctTSepBeFPWW9gP7rh6X-LGykCU3wL6a_VbpdBhgxQPrlkyKebXPoWjOPSUmOOgD4QO4Yl50ZRfOEQd3pqdoQ29Vodt9g06Pr5sTZnhSgJ6m3maIrTLz-AfMqSq1C6BXCVsq67spp1FXslV_I-hnY"
                            alt="Russet Potatoes">
                        <div class="media-body">
                            <h6 class="mt-0 mb-1 text-dark font-weight-bold">Russet Potatoes</h6>
                            <p class="text-primary font-weight-bold mb-0">$5.00</p>
                        </div>
                    </div>

                </div>
            </aside>

            <div class="col-lg-9">

                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <p class="text-muted mb-0">Showing 1-9 of 24 results</p>
                    <form class="form-inline">
                        <select class="form-control form-control-sm border-secondary text-secondary">
                            <option>Sắp xếp mặc định</option>
                            <option>Sắp xếp theo độ phổ biến</option>
                            <option>Sắp xếp theo giá: thấp đến cao</option>
                            <option>Sắp xếp theo giá: cao đến thấp</option>
                        </select>
                    </form>
                </div>

                <div class="row">
                    @foreach (var item in Model)
                    { 
                    <div class="col-md-6 col-xl-4 mb-4">
                        <div class="card product-card h-100 border-0" >
                            <div class="product-img-wrapper" style="height: 300px;">
                                <img class="card-img-top h-100" style="object-fit: cover;"
                                    src="~/product/@item.ImgUrl"
                                    alt="@item.Name">
                                <div class="hover-overlay">
                                    <button class="btn btn-primary rounded-pill px-4 add-to-cart-btn">Thêm vào giỏ</button>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <h5 class="card-title font-display font-weight-bold h6 text-dark">@item.Name</h5>
                                <p class="card-text text-primary font-weight-bold">@item.Price đ</p>
                            </div>
                        </div>
                    </div>

                     }



                </div>
                <nav aria-label="Page navigation" class="mt-5">
                    <ul class="pagination justify-content-center">
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">
                                <span class="material-icons-outlined"
                                    style="font-size: 16px; vertical-align: middle;">east</span>
                            </a>
                        </li>
                    </ul>
                </nav>

            </div>
        </div>
    </main>
 
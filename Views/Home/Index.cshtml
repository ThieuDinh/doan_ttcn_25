@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="~/css/about.css" />
<div class="container-home">
    <div id="banner1" class="carousel slide carousel-fade" data-ride="carousel" data-interval="6000">
        <ol class="carousel-indicators">
            <li data-target="#banner1" data-slide-to="0" class="active"></li>
            <li data-target="#banner1" data-slide-to="1"></li>
            <li data-target="#banner1" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner" role="listbox">
            <div class="carousel-item active">
                <img src="~/images/banner.jpg" alt="First slide" class="d-block img-fluid">
                <div class="carousel-caption relative">

                </div>
            </div>
            <!-- /.carousel-item -->
            <div class="carousel-item">
                <img src="~/images/banner2.webp" alt="Second slide" class="d-block img-fluid">
                <div class="carousel-caption relative">

                </div>
            </div>
            <!-- /.carousel-item -->
            <div class="carousel-item">
                <img src="~/images/banner3.jpg" alt="Third slide" class="d-block img-fluid">
                <div class="carousel-caption relative">

                </div>
            </div>
            <!-- /.carousel-item -->
        </div>
        <!-- /.carousel-inner -->
        <a class="carousel-control-prev" href="#banner1" role="button" data-slide="prev">
            <i class="fa fa-angle-left" aria-hidden="true"></i>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#banner1" role="button" data-slide="next">
            <i class="fa fa-angle-right" aria-hidden="true"></i>
            <span class="sr-only">Next</span>
        </a>
    </div>
    <!-- /.about -->
    <div class="container mt-4">

        <h2 class="about-us">Về Chúng Tôi</h2>
        <div class="row-about">
            <div class="col-md-6 ">

                <p>
                    Farm2Home là cầu nối đưa nông sản sạch từ các farm công nghệ cao tại Đà Lạt đến tận tay người tiêu
                    dùng.
                    Chúng tôi cam kết nguồn gốc rõ ràng, chất lượng tuyển chọn, ứng dụng công nghệ bảo quản hiện đại
                    nhằm giữ trọn độ tươi và hương vị tự nhiên của từng sản phẩm.

                    Từ các sản phẩm chế biến từ nông sản, Farm2Home mang đến trải nghiệm tiêu dùng an toàn – tiện lợi –
                    đáng tin cậy, để mỗi sản phẩm không chỉ ngon mà còn là sự an tâm cho sức khỏe gia đình bạn.
                </p>
            </div>
            <img src="~/img/farm_caudat.jpg" alt="Farm1 Image" class="col-md-6 img-fluid">
        </div>
        <input type="button" class="btn btn-light btn-lg" value="Tìm hiểu thêm"
            onclick="window.location.href='/Farm/index'">
        <img src="~/img/bghome_about.png" alt="About Image" class="img-fluid w-100"
            style="position: absolute; bottom: 0;">
    </div>



    <div class="container mt-5">
        <hr class="footer-line">
        <h2 class="text-center mb-5">Top 3 Sản phẩm bán chạy</h2>
        <div class="row justify-content-center" style="gap: 40px; margin-bottom: 40px;">
            @if (ViewData["TopSales"] is IEnumerable<dynamic> topSales && topSales.Any())
            {
                <div class="d-flex justify-content-center align-items-end" style="gap: 20px;">
                    @if (topSales.Count() > 1)
                    {
                        var product = topSales.ElementAt(1); // Top 2
                                                             <a href="/Product/Detail/@product.ProductId" style="text-decoration: none; color: inherit;">
                                                                 <div class="text-center" style="width: 200px; position: relative; bottom: 0;">
                                                                     <div class="position-relative d-inline-block">
                                                                         <img src="@product.ImageUrl" alt="@product.ProductName" class="rounded-circle img-fluid"
                                                                             style="width: 150px; height: 150px;">
                                                                         <span class="badge badge-danger position-absolute" style="top: 10px; right: 10px;">Top
                                                                             2</span>
                                                                     </div>
                                                                     <h5 class="mt-3">@product.ProductName</h5>
                                                                     <p class="mb-1 text-warning">
                                    @for (int star = 0; star < product.Rating; star++)
                                    {
                                        <i class="fa fa-star"></i>
                                    }
                                </p>
                                <p class="text-muted">Đã bán: @product.TotalSold</p>
                            </div>
                        </a>
                    }
                    @if (topSales.Count() > 0)
                    {
                        var product = topSales.ElementAt(0); // Top 1
                                                             <a href="/Product/Detail/@product.ProductId" style="text-decoration: none; color: inherit;">
                                                                 <div class="text-center" style="width: 300px; position: relative; bottom: 0;">
                                                                     <div class="position-relative d-inline-block">
                                                                         <img src="@product.ImageUrl" alt="@product.ProductName" class="rounded-circle img-fluid"
                                                                             style="width: 200px; height: 200px;">
                                                                         <span class="badge badge-danger position-absolute" style="top: 10px; right: 10px;">Top
                                                                             1</span>
                                                                     </div>
                                                                     <h5 class="mt-3">@product.ProductName</h5>
                                                                     <p class="mb-1 text-warning">
                                    @for (int star = 0; star < product.Rating; star++)
                                    {
                                        <i class="fa fa-star"></i>
                                    }
                                </p>
                                <p class="text-muted">Đã bán: @product.TotalSold</p>
                            </div>
                        </a>
                    }
                    @if (topSales.Count() > 2)
                    {
                        var product = topSales.ElementAt(2); // Top 3
                                                             <a href="/Product/Detail/@product.ProductId" style="text-decoration: none; color: inherit;">
                                                                 <div class="text-center" style="width: 200px; position: relative; bottom: 0;">
                                                                     <div class="position-relative d-inline-block">
                                                                         <img src="@product.ImageUrl" alt="@product.ProductName" class="rounded-circle img-fluid"
                                                                             style="width: 150px; height: 150px;">
                                                                         <span class="badge badge-danger position-absolute" style="top: 10px; right: 10px;">Top
                                                                             3</span>
                                                                     </div>
                                                                     <h5 class="mt-3">@product.ProductName</h5>
                                                                     <p class="mb-1 text-warning">
                                    @for (int star = 0; star < product.Rating; star++)
                                    {
                                        <i class="fa fa-star"></i>
                                    }
                                </p>
                                <p class="text-muted">Đã bán: @product.TotalSold</p>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="text-center text-muted">Không có dữ liệu để hiển thị.</p>
            }

        </div>

    </div>

    <section class="review-section container mt-5 mb-5">
        <hr class="footer-line">
        <h2 class="text-center mb-4">Khách hàng nói gì về Farm2Home</h2>

        <div class="review-list">
            @foreach (var r in ViewBag.Reviews)
            {
                <div class="review-item">


                    <div class="review-avatar">
                        <img src="~/images/test2.png" />
                    </div>
                    <div class="review-content">
                        <span class="review-name">@r.UserName</span>
                        <div class="review-header">
                            <strong>Đánh giá cho sản phẩm @r.ProductName</strong>
                            <span class="review-date">
                                @r.CreatedAt.ToString("dd/MM/yyyy")
                            </span>
                        </div>


                        <div class="review-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= r.Rating)
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span class="star-empty">☆</span>
                                }
                            }
                        </div>

                        <p>@r.Content</p>
                    </div>
                </div>
            }
        </div>
    </section>


    <div class="container mt-5">
        <hr class="footer-line">
        <h2 class="text-center">Địa chỉ cửa hàng</h2>
        <p>180, Cao Lỗ, phường Chánh Hưng, TP.HCM</p>
        <div class="map-responsive">
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4587.235805968696!2d106.67600141929769!3d10.73749858911814!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f62a90e5dbd%3A0x674d5126513db295!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBDw7RuZyBuZ2jhu4cgU8OgaSBHw7Ju!5e1!3m2!1svi!2s!4v1768019943245!5m2!1svi!2s"
                width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>

</div>
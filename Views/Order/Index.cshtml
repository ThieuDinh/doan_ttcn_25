@model IEnumerable<doan_ttcn.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <style>
        /* ... Giữ nguyên CSS cũ ... */
        /* Thêm class màu sắc cho trạng thái */
        .badge-pending {
            background-color: #ffc107;
            color: #000;
        }

        .badge-shipping {
            background-color: #17a2b8;
            color: #fff;
        }

        .badge-completed {
            background-color: #28a745;
            color: #fff;
        }

        .badge-cancelled {
            background-color: #dc3545;
            color: #fff;
        }

        .badge-confirmed {
            background-color: #007bff;
            color: #fff;
        }

        body {
            font-family: "Roboto", sans-serif;
            background-color: #f7f7f7;
            color: #333;
        }

        .font-display {
            font-family: "Work Sans", sans-serif;
        }

        .text-primary {
            color: #4CAF50 !important;
        }

        .bg-primary {
            background-color: #4CAF50 !important;
        }

        .btn-primary {
            background-color: #4CAF50;
            border-color: #4CAF50;
        }
    </style>
    <link rel="stylesheet" href="~/css/order.css">
}

<div class="page-header text-center">
    <h1 class="font-display font-weight-bold">Đơn hàng của tôi</h1>
</div>

<div class="container pb-5">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="border-0 py-3">Mã đơn</th>
                            <th class="border-0 py-3">Ngày đặt</th>
                            <th class="border-0 py-3">Tổng tiền</th>
                            <th class="border-0 py-3">Trạng thái</th>
                            <th class="border-0 py-3 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle font-weight-bold">@item.Id</td>
                                <td class="align-middle">@item.OrderDate.ToString("dd/MM/yyyy")</td>
                                <td class="align-middle text-primary font-weight-bold">@item.FinalAmount.ToString("#,##0") đ
                                </td>
                                <td class="align-middle">
                                    @{
                                        string badgeClass = item.Status switch
                                        {
                                            OrderStatus.Pending => "badge-pending",
                                            OrderStatus.Shipping => "badge-shipping",
                                            OrderStatus.Completed => "badge-completed",
                                            OrderStatus.Cancelled => "badge-cancelled",
                                            _ => "badge-confirmed"
                                        };
                                        string statusText = item.Status switch
                                        {
                                            OrderStatus.Pending => "Chờ xử lý",
                                            OrderStatus.Shipping => "Đang giao",
                                            OrderStatus.Completed => "Hoàn thành",
                                            OrderStatus.Cancelled => "Đã hủy",
                                            _ => "Đã xác nhận"
                                        };
                                    }
                                    <span class="badge badge-status @badgeClass">@statusText</span>
                                </td>
                                <td class="align-middle text-right">

                                    <a asp-action="Detail" asp-route-id="@item.Id">Chi tiết</a> |
                                    @if (item.Status == OrderStatus.Pending)
                                    {

                                        <a data-toggle="modal" data-target="#cancelModal" onclick="setCancelId(@item.Id)"
                                            asp-action="Cancel" asp-route-id="@item.Id">Hủy đơn</a>
                                    }
                                   
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold">Xác nhận hủy đơn</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn hủy đơn hàng này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <form asp-action="CancelOrder" method="post">
                    <input type="hidden" name="id" id="cancelOrderId" value="" />
                    <button type="submit" class="btn btn-danger">Xác nhận Hủy</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function setCancelId(id) {
            document.getElementById("cancelOrderId").value = id;
        }
    </script>
}
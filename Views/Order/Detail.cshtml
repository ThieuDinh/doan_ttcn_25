@using Microsoft.AspNetCore.Razor.Language

@model doan_ttcn.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";

}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <style>
        body {
            font-family: "Roboto", sans-serif;
            background-color: #f7f7f7;
            color: #333;
        }

        .font-display {
            font-family: "Work Sans", sans-serif;
        }

        .text-primary {
            color: #4CAF50 !important;
        }

        .bg-primary {
            background-color: #4CAF50 !important;
        }

        .btn-primary {
            background-color: #4CAF50;
            border-color: #4CAF50;
        }
    </style>
    <link rel="stylesheet" href="~/css/order.css">
}
@if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
<div class="bg-light py-3 border-bottom mb-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="font-display font-weight-bold mb-0">Chi tiết đơn hàng @Model.Id</h3>
                <small class="text-muted">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy")</small>
            </div>
            <div>
                <span class="badge badge-status badge-pending" style="font-size: 1rem;">@Model.Status</span>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white font-weight-bold py-3">
                    <i class="fa fa-shopping-basket mr-2 text-primary"></i> Sản phẩm
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="pl-4" style="width: 100px;">
                                            <img src="~/product/@item.Product.ImageUrl" class="order-product-img"
                                                alt="Product" style="width: 70px;">
                                        </td>
                                        <td class="align-middle">
                                            <h6 class="font-weight-bold mb-1">
                                                <a href="#" class="text-dark text-decoration-none">@item.Product.Name</a>
                                            </h6>

                                            @if (Model.Status == OrderStatus.Completed)
                                            {
                                                @if (item.IsReviewed) // Check từng OrderDetail
                                                {
                                                    <small class="text-success"><i class="fa fa-check-circle"></i> Đã đánh
                                                        giá</small>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Review" asp-action="Create" asp-route-orderId="@Model.Id"
                                                        asp-route-productId="@item.ProductId"
                                                        class="text-primary small text-decoration-underline">
                                                        Viết đánh giá
                                                    </a>
                                                }
                                            }
                                        </td>
                                        <td class="align-middle text-center">x @item.Quantity</td>
                                        <td class="align-middle text-right font-weight-bold pr-4">
                                            @item.Price.ToString("#,##0") đ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light text-right">
                    <div class="row justify-content-end">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Giảm giá:</span>
                                <span>@Model.DiscountAmount.ToString("#,##0") đ</span>
                            </div>

                            <div class="d-flex justify-content-between border-top pt-2">
                                <span class="font-weight-bold h5 mb-0">Tổng cộng:</span>
                                <span class="font-weight-bold h5 text-primary mb-0">@Model.TotalAmount.ToString("#,##0")
                                    đ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left mr-1"></i> Quay lại danh sách
            </a>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white font-weight-bold py-3">
                    <i class="fa fa-map-marker mr-2 text-primary"></i> Địa chỉ nhận hàng
                </div>
                <div class="card-body">
                    <h6 class="font-weight-bold">@Model.ShipToName</h6>
                    <p class="mb-1 text-muted small"><i class="fa fa-phone mr-1"></i> @Model.ShipToPhone</p>
                    <p class="mb-0 text-muted small">
                        @Model.ShipToAddress
                    </p>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white font-weight-bold py-3">
                    <i class="fa fa-credit-card mr-2 text-primary"></i> Thanh toán
                </div>
                <div class="card-body">
                    <p class="mb-0 text-secondary">@Model.PaymentMethod</p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white font-weight-bold py-3">
                    <i class="fa fa-sticky-note mr-2 text-primary"></i> Ghi chú
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted font-italic small">@Model.Note</p>
                </div>
            </div>
        </div>
    </div>
</div>
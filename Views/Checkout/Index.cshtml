@model doan_ttcn.ViewModels.CheckoutVM

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css">
}
@{
    ViewData["Title"] = "Index";
}
<div class="container-fluid py-5">
    <div class="container py-5">
        <h1 class="mb-4">Chi tiết thanh toán</h1>
        <form form asp-action="Checkout" asp-controller="Checkout" method="post">
            <div class="row g-5">
                <div class="col-md-12 col-lg-5 ">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-item w-100">
                                <label class="form-label my-3">Họ và tên<sup>*</sup></label>
                                <input asp-for="FullName" type="text" class="form-control">
                            </div>
                        </div>

                    </div>

                    <div class="form-item">
                        <label class="form-label my-3">Địa chỉ <sup>*</sup></label>
                        <input asp-for="Address" type="text" class="form-control">
                    </div>
                    <div class="form-item">
                        <label class="form-label my-3">Số điện thoại<sup>*</sup></label>
                        <input asp-for="Phone" type="tel" class="form-control">
                    </div>
                    <hr>
                    <div class="form-item">
                        <textarea asp-for="Note" class="form-control" spellcheck="false" cols="30" rows="5" placeholder="Ghi chú đơn hàng"></textarea>
                    </div>
                </div>
                <div class="col-md-12 col-lg-7">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">Sản phẩm</th>
                                    <th scope="col">Tên sản phẩm</th>
                                    <th scope="col">Giá</th>
                                    <th scope="col">Số lượng</th>
                                    <th scope="col">Tổng cộng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <th scope="row">
                                            <div class="d-flex align-items-center mt-2">
                                                <img src="~/product/@item.ImageUrl" class="img-fluid rounded-circle"
                                                    style="width: 90px; height: 90px;" alt="">
                                            </div>
                                        </th>
                                        <td class="py-5">@item.ProductName</td>
                                        <td class="py-5">@item.Price</td>
                                        <td class="py-5">@item.Quantity</td>
                                        <td class="py-5">@(item.Price* item.Quantity)</td>
                                    </tr>
                                }

                                <tr>
                                    <th scope="row">
                                    </th>
                                    <td class="py-5"></td>
                                    <td class="py-5"></td>
                                    <td class="py-5">
                                        <p class="mb-0 text-dark py-3">Tổng</p>
                                    </td>
                                    <td class="py-5">
                                        <div class="py-3 border-bottom border-top">
                                            <p class="mb-0 text-dark">@(Model.CartItems.Sum(item => item.Price *
                                                                                                item.Quantity).ToString("#,##0")) đ</p>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">
                                    </th>
                                    <td class="py-5">
                                        <p class="mb-0 text-dark py-4">Phí vận chuyển</p>
                                    </td>
                                    <td colspan="3" class="py-5">
                                        <div class="form-check text-start">

                                            <label class="form-check-label" for="Shipping-1">Miễn phí vận chuyển</label>
                                        </div>

                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">
                                    </th>
                                    <td class="py-5">
                                        <p class="mb-0 text-dark text-uppercase py-3">TỔNG CỘNG</p>
                                    </td>
                                    <td class="py-5"></td>
                                    <td class="py-5"></td>
                                    <td class="py-5">
                                        <div class="py-3 border-bottom border-top">
                                            <p class="mb-0 text-dark">@Model.GrandTotal.ToString("#,##0") đ</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="row g-4 align-items-center justify-content-center border-bottom py-3">
                        <div class="col-12">
                            <div class="form-check my-3">
                                <input type="radio" class="form-check-input bg-primary border-0" id="Delivery-1"
                                    asp-for="PaymentMethod" value="COD" checked>
                                <label class="form-check-label" for="Delivery-1">Thanh toán khi nhận hàng (COD)</label>
                            </div>
                            <div class="form-check my-3">
                                <input type="radio" class="form-check-input bg-primary border-0" id="Paypal-1"
                                    asp-for="PaymentMethod" value="Banking">
                                <label class="form-check-label" for="Paypal-1">Chuyển khoản</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 text-center align-items-center justify-content-center pt-4">

                        <button type="submit"
                            class="btn border-secondary py-3 px-4 text-uppercase w-100 text-primary">Đặt hàng</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
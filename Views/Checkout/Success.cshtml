@model doan_ttcn.ViewModels.OrderSuccessVM
@{
    ViewData["Title"] = "Đặt hàng thành công";

}

@section Styles {

    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/order-success.css">

}

<div class="container py-5 mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-lg text-center p-4">
                <div class="card-body">
                    <div class="success-icon-container mb-4">
                        <div class="success-icon-bg"></div>
                        <span class="material-icons-outlined text-white success-icon">check</span>
                    </div>

                    <h1 class="font-display font-weight-bold text-dark mb-3">Đặt hàng thành công!</h1>

                    <p class="text-muted mb-4">
                        Cảm ơn bạn đã mua sắm tại <strong>Farm2Home</strong>.<br>
                        Đơn hàng của bạn đang được xử lý.
                    </p>

                    <div class="bg-light rounded p-3 mb-4 text-left order-info-box">
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="text-secondary small font-weight-bold">Mã đơn hàng: </span>
                            <span class="text-dark font-weight-bold">@Model.OrderId</span>
                        </div>
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="text-secondary small font-weight-bold">Ngày đặt:</span>
                            <span class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="text-secondary small font-weight-bold">Phương thức:</span>
                            <span class="text-dark">@Model.PaymentMethod</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-secondary small font-weight-bold">Tổng tiền:</span>
                            <span class="text-primary font-weight-bold">@Model.Amount.ToString("#,##0") đ</span>
                        </div>
                    </div>



                    <div class="d-flex justify-content-center">
                        <a href="@Url.Action("Index", "Product")"
                            class="btn btn-primary rounded-pill px-4 py-2 mr-3 font-weight-bold shadow-sm">
                            <i class="fa fa-shopping-bag mr-2"></i> Tiếp tục mua
                        </a>
                        <a href="@Url.Action("Index", "Account")"
                            class="btn btn-outline-secondary rounded-pill px-4 py-2 font-weight-bold">
                            Xem đơn hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
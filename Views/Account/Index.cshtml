@model doan_ttcn.ViewModels.UserProfileVM

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

@section Styles {
    <link rel="stylesheet" href="~/css/userinfo.css">
}
<div class="bg-light  text-center border-bottom mt-5 ">
    <div class="container">

        <h1 class="font-display font-weight-bold display-4 text-dark">Thông tin cá nhân</h1>

    </div>
</div>
<div class="container pb-5 py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="auth-switch-wrapper">
                    <span class="auth-switch-btn active">Thông tin chung</span>
                    <a href="@Url.Action("ChangePassword", "Account")" class="auth-switch-btn">Đổi mật khẩu</a>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateInfo" method="post">
                        <input type="hidden" asp-for="UserId" />

                        <div class="form-group">
                            <label class="  font-weight-bold">Họ và tên</label>
                            <input asp-for="Fullname" class="form-control" placeholder="Nhập họ tên của bạn" />
                            <span asp-validation-for="Fullname" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label class=" font-weight-bold">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label class=" font-weight-bold">Địa chỉ</label>
                            <textarea asp-for="Address" class="form-control" rows="3"
                                placeholder="Nhập địa chỉ giao hàng"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="text-right mt-4">
                            <button type="submit" class="btn btn-primary px-4">Lưu thông tin</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>


    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
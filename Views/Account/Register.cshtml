@model doan_ttcn.ViewModels.RegisterVM
@{
  ViewBag.Title = "Đăng ký";
  Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng ký - Farm2Home</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    rel="stylesheet" />

  <style>
    body {
      font-family: "Be Vietnam Pro", sans-serif;
      background-color: #fff;
      color: #333;
      overflow-x: hidden;
    }

    :root {
      --primary-accent: #4caf50;
      --primary-accent-dark: #388e3c;
      --border-light: #d7e7cf;
    }

    .text-primary-custom {
      color: var(--primary-accent) !important;
    }

    .btn-primary-custom {
      background-color: var(--primary-accent);
      border-color: var(--primary-accent);
      color: white;
      transition: all 0.3s;
    }

    .btn-primary-custom:hover {
      background-color: var(--primary-accent-dark);
      border-color: var(--primary-accent-dark);
      color: white;
    }

    .form-control {
      padding: 0.7rem 1rem;
      border-color: var(--border-light);
      border-radius: 0.5rem;
    }

    .form-control:focus {
      border-color: var(--primary-accent);
      box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
    }

    /* Toggle Switch Style */
    .auth-switch-wrapper {
      background-color: #f8f9fa;
      padding: 5px;
      border-radius: 8px;
      display: inline-flex;
      width: 100%;
      margin-bottom: 20px;
    }

    .auth-switch-btn {
      flex: 1;
      padding: 8px;
      text-align: center;
      border-radius: 6px;
      text-decoration: none;
      color: #666;
      font-weight: 500;
      transition: all 0.2s;
    }

    .auth-switch-btn.active {
      background-color: #fff;
      color: #333;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
      font-weight: 700;
    }

    .auth-switch-btn:hover:not(.active) {
      color: var(--primary-accent);
      background-color: rgba(0, 0, 0, 0.02);
    }

    /* Left Side Image settings */
    .bg-login-image {
      background-image: url('/img/login2.jpg');
      /* Đảm bảo đường dẫn ảnh đúng */
      background-size: cover;
      background-position: center;
      height: 100vh;
      /* Full chiều cao màn hình */
      width: 100%;
    }

    /* Right Side Form settings */
    .login-content {
      height: 100vh;
      overflow-y: auto;
      /* Cho phép cuộn nếu màn hình quá thấp */
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-form-inner {
      width: 100%;
      max-width: 480px;
      /* Giới hạn chiều rộng nội dung form để không bị bè ra quá mức trên màn to */
      padding: 40px;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
      .bg-login-image {
        height: 250px;
        display: none;
      }

      /* Ẩn ảnh hoặc thu nhỏ trên mobile */
      .login-content {
        height: auto;
        align-items: flex-start;
        padding-top: 40px;
      }

      .login-form-inner {
        padding: 20px;
      }
    }
  </style>
</head>

<body>
  <div class="container-fluid p-0">
    <div class="row g-0">

      <div class="col-md-6 col-lg-7 d-none d-md-block">
        <div class="bg-login-image"></div>
      </div>

      <div class="col-md-6 col-lg-5 bg-white">
        <div class="login-content">
          <div class="login-form-inner">

            <div class="d-flex align-items-center gap-3 mb-4">
              <img src="/img/logo-bg.png" alt="Logo" width="80" class="rounded" />
              <h2 class="fw-bold m-0 fs-4 text-dark">Farm2Home</h2>
            </div>

            <h1 class="fw-bold mb-2 fs-3">Tạo tài khoản mới</h1>


            <div class="auth-switch-wrapper">
              <a href="@Url.Action("Login", "Account")" class="auth-switch-btn">Đăng nhập</a>
              <span class="auth-switch-btn active">Đăng ký</span>
            </div>
            <div asp-validation-summary="All" class="text-danger mb-3 p-3 border border-danger rounded"></div>
            <form asp-controller="Account" asp-action="Register" method="post">
              @Html.AntiForgeryToken()
              <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

              <div class="mb-3">
                <label asp-for="Email" class="form-label fw-medium small">Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
              </div>

              <div class="mb-3">
                <label asp-for="Password" class="form-label fw-medium small">Mật khẩu</label>
                <div class="input-group">
                  <input asp-for="Password" type="password" class="form-control border-end-0" id="registerPassword"
                    placeholder="••••••••" />

                  <span class="input-group-text bg-white border-start-0 text-muted" style="cursor: pointer;"
                    id="btnToggleAllPasswords">
                    <span class="material-symbols-outlined fs-6" id="iconEyeMaster">visibility</span>
                  </span>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
              </div>

              <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-medium small">Nhập lại mật khẩu</label>

                <input asp-for="ConfirmPassword" type="password" class="form-control" id="registerConfirmPassword"
                  placeholder="••••••••" />

                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
              </div>

              <div class="d-grid mb-4">
                <button type="submit" class="btn btn-primary-custom py-2 fw-bold">Đăng ký ngay</button>
              </div>
            </form>

            <div class="position-relative text-center mb-4">
              <hr class="text-muted opacity-25">
              <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">Hoặc đăng
                ký với</span>
            </div>

            <div class="row">
              <div class="col-12">
                <button
                  class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2 py-2 small"
                  style="border-color: #eee;">
                  <img
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuCY0lrnwjPBZ273SiCNSqjnXOifiGs1iGxi5oSiW6ORBBGFjm7WPn1cvC6YCE2pDUszW_QKpXAgt08G4HJddaEvHRcW4L7bOtGoCe9RMmJGZ-gkpegH9H-V3C9lUVdF-yi5Ld0PmSRwwU5BAnck_G1cxRal3aFH8hJjcgQ6KE-F0teRIrEi41yvpemsjNTixtistYTJQ_ZNOCJ5_qlpxB8tJDAj46nkEgH12JxYNyaPmFh4BGAFnU_rDxLH21YWjmUSerNUhdG07hk"
                    alt="Google" width="18" height="18">
                  <span class="fw-medium">Google</span>
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
 <script>
    document.addEventListener("DOMContentLoaded", function() {
        // Lấy nút bấm (Master Button)
        const toggleBtn = document.getElementById('btnToggleAllPasswords');
        const iconSpan = document.getElementById('iconEyeMaster');

        // Lấy 2 ô input theo ID
        const pass1 = document.getElementById('registerPassword');
        const pass2 = document.getElementById('registerConfirmPassword');

        if (toggleBtn && pass1 && pass2) {
            toggleBtn.addEventListener('click', function () {
                // Kiểm tra trạng thái hiện tại của ô pass1
                const currentType = pass1.getAttribute('type');
                
                // Xác định trạng thái mới (nếu đang password thì thành text, và ngược lại)
                const newType = currentType === 'password' ? 'text' : 'password';

                // Áp dụng cho CẢ 2 ô
                pass1.setAttribute('type', newType);
                pass2.setAttribute('type', newType);

                // Đổi icon
                iconSpan.textContent = newType === 'text' ? 'visibility_off' : 'visibility';
            });
        }
    });
</script>
</body>

</html>
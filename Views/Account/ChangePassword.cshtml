@model doan_ttcn.ViewModels.UserProfileVM

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

@section Styles {
    <link rel="stylesheet" href="~/css/userinfo.css">
}
<div class="bg-light  text-center border-bottom mt-5 ">
    <div class="container">

        <h1 class="font-display font-weight-bold display-4 text-dark">Thông tin cá nhân</h1>

    </div>
</div>
<div class="container pb-5 py-5">
@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
}
    <div class="row justify-content-center">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="auth-switch-wrapper">
                    <a href="@Url.Action("Index", "Account")" class="auth-switch-btn">Thông tin chung</a>
                    <span class="auth-switch-btn active">Đổi mật khẩu</span>
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post">
                        <input type="hidden" asp-for="UserId" />

                        <div class="form-group">
                            <label class="font-weight-bold">Mật khẩu hiện tại</label>
                            <input asp-for="Password" type="" class="form-control" placeholder="********" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <hr class="my-4 border-light" />

                        <div class="form-group">
                            <label class="font-weight-bold">Mật khẩu mới</label>
                            <input asp-for="NewPassword" type="" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold">Nhập lại mật khẩu mới</label>
                            <input asp-for="ConfirmPassword" type="" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="text-right mt-4">
                            <button type="submit" class="btn btn-warning text-white px-4">Đổi mật khẩu</button>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
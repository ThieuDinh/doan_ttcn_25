@model doan_ttcn.Models.Product

@{
    ViewData["Title"] = "Chi tiết lô hàng";
    var batches = ViewBag.Batches as List<doan_ttcn.Models.ProductBatch>;
    int totalStock = batches?.Sum(b => b.RemainingQuantity) ?? 0;
}

<h1>Details</h1>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Quản lý Lô hàng: @Model.Name</h1>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-2">
                 <img src="~/product/@Model.ImageUrl" style="width: 100%; object-fit: contain;" />
            </div>
            <div class="col-md-10">
                <h4>@Model.Name</h4>
                <p><strong>Danh mục:</strong> @Model.Category?.Name</p>
                <p><strong>Giá bán:</strong> @Model.Price.ToString("#,##0") đ</p>
                <p class="text-primary" style="font-size: 1.2rem;">
                    <strong>Tổng tồn kho:</strong> @totalStock sản phẩm
                </p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 font-weight-bold">Danh sách các Lô hàng (Batches)</h5>
        
        <a asp-action="Create" asp-route-productId="@Model.Id" class="btn btn-success">
            <i class="fa fa-plus-circle"></i> Nhập lô mới
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Ngày nhập</th>
                    <th>Hạn sử dụng</th>
                    <th>Số lượng nhập</th>
                    <th>Tồn kho (Remaining)</th>
                    <th>Trạng thái</th>
                    <th class="text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (batches != null && batches.Any())
                {
                    foreach (var item in batches)
                    {
                        // Logic kiểm tra hạn sử dụng để đổi màu
                        string rowClass = "";
                        string status = "Còn hạn";
                        if (item.ExpireDate < DateTime.Now) 
                        {
                            rowClass = "table-danger"; // Đỏ nếu hết hạn
                            status = "Hết hạn";
                        }
                        else if (item.ExpireDate < DateTime.Now.AddDays(30))
                        {
                            rowClass = "table-warning"; // Vàng nếu sắp hết hạn
                            status = "Sắp hết hạn";
                        }

                        <tr class="@rowClass">
                            <td>@item.ImportDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.ExpireDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.Quantity</td>
                            <td class="font-weight-bold">@item.RemainingQuantity</td>
                            <td>@status</td>
                            <td class="text-right">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    Sửa
                                </a>
                                
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn chắc chắn muốn xóa lô này?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Sản phẩm này chưa có lô hàng nào. Hãy nhập lô mới!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model doan_ttcn.Models.ProductBatch

@{
    ViewData["Title"] = "Nhập lô hàng mới";
}

<h4>Nhập lô hàng mới cho: <span class="text-primary">@ViewBag.ProductName</span></h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <input type="hidden" asp-for="ProductId" />

            <div class="form-group mb-3">
                <label asp-for="ImportDate" class="control-label fw-bold">Ngày nhập</label>
                <input asp-for="ImportDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="ImportDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ExpireDate" class="control-label fw-bold">Hạn sử dụng</label>
                <input asp-for="ExpireDate" class="form-control" type="date" />
                <span asp-validation-for="ExpireDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label fw-bold">Số lượng nhập</label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success px-4">Lưu lô hàng</button>
                <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-secondary">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
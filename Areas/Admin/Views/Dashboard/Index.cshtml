@{
    ViewData["Title"] = "Home Page";
}
<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
       
    </div>

    <!-- Content Row -->
    <div class="row">

        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Doanh thu tháng</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @ViewBag.TotalRevenue.ToString("#,##0") đ
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Earnings (Monthly) Card Example -->
       
       

        <!-- Pending Requests Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Đơn hàng chờ duyệt</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.PendingCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-comments fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row -->

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-3 d-flex align-items-center">
                    <label class="mr-3 font-weight-bold mb-0">Chọn loại thống kê:</label>
                    <select id="reportType" class="form-control w-50">
                        <option value="month">Doanh thu theo Tháng (Năm nay)</option>
                        <option value="year">Doanh thu theo Năm</option>
                        <option value="product">Top Sản phẩm bán chạy</option>
                        <option value="channel">Tỷ trọng Kênh bán hàng</option>
                    </select>
                    <button onclick="loadChart()" class="btn btn-primary ml-3">Xem</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary" id="chartTitle">Biểu đồ thống kê</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area" style="height: 400px;">
                        <canvas id="dynamicChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row -->


</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Biến toàn cục lưu biểu đồ hiện tại (để hủy trước khi vẽ mới)
        var myChart = null;

        // Hàm gọi API và vẽ biểu đồ
        function loadChart() {
            var type = document.getElementById("reportType").value;
            var url = '';
            var label = '';
            var chartType = 'line'; // Mặc định là biểu đồ đường

            // 1. Xác định API cần gọi dựa trên lựa chọn
            if (type === 'month') {
                url = '/Admin/Dashboard/GetRevenueByMonth?year=' + new Date().getFullYear();
                label = 'Doanh thu (VNĐ)';
                chartType = 'line';
            } else if (type === 'year') {
                url = '/Admin/Dashboard/GetRevenueByYear';
                label = 'Doanh thu (VNĐ)';
                chartType = 'bar'; 
            } else if (type === 'product') {
                url = '/Admin/Dashboard/GetTopProducts';
                label = 'Số lượng bán';
                chartType = 'bar'; 
            }
            else if (type === 'channel') {
                url = '/Admin/Dashboard/GetRevenueByChannel';
                label = 'Doanh thu (VNĐ)';
                chartType = 'pie'; 
            }

         
            fetch(url)
                .then(response => response.json())
                .then(data => {
                  
                    var labels = data.map(x => x.label);
                    var values = data.map(x => x.value);

               
                    renderChart(labels, values, label, chartType);
                })
                .catch(err => console.error("Lỗi tải dữ liệu:", err));
        }

    
        function renderChart(labels, values, datasetLabel, type) {
            var ctx = document.getElementById("dynamicChart").getContext('2d');

         
            if (myChart) {
                myChart.destroy();
            }

            myChart = new Chart(ctx, {
                type: type, 
                data: {
                    labels: labels,
                    datasets: [{
                        label: datasetLabel,
                        data: values,
                        backgroundColor: 'rgba(78, 115, 223, 0.5)',
                        borderColor: 'rgba(78, 115, 223, 1)',    
                        borderWidth: 2,
                        pointRadius: 4,
                        pointBackgroundColor: "rgba(78, 115, 223, 1)",
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return value.toLocaleString('vi-VN'); 
                                }
                            }
                        }
                    }
                }
            });
        }

    
        document.addEventListener("DOMContentLoaded", function () {
            loadChart();
        });
    </script>
}
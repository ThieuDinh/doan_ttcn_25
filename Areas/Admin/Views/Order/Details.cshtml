@model doan_ttcn.Models.Order
@using doan_ttcn.Models

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi tiết đơn hàng #@Model.Id</h1>
    
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
   
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-1"></i> @TempData["Error"]
        </div>
    }
    <div class="row">
        <div class="col-lg-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-info-circle me-1"></i>
                    Thông tin đơn hàng
                </div>
                <div class="card-body">
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Người nhận:</strong> @Model.ShipToName</p>
                    <p><strong>SĐT:</strong> @Model.ShipToPhone</p>
                    <p><strong>Địa chỉ:</strong> @Model.ShipToAddress</p>
                    <p><strong>Ghi chú:</strong> @(Model.Note ?? "Không có")</p>
                    <p><strong>Thanh toán:</strong> @Model.PaymentMethod</p>
                    <hr />
                    
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Trạng thái đơn hàng:</label>
                            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<OrderStatus>()" asp-for="Status">
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-save"></i> Cập nhật trạng thái
                        </button>
                    </form>
                </div>
            </div>
            
            <div class="card mb-4 shadow-sm">
                <div class="card-header">
                    <i class="fas fa-money-bill me-1"></i> Tổng quan tài chính
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span>Tổng tiền hàng:</span>
                        <span>@Model.TotalAmount.ToString("#,##0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between text-success">
                        <span>Giảm giá:</span>
                        <span>-@Model.DiscountAmount.ToString("#,##0") đ</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold fs-5 text-primary">
                        <span>Thực thu:</span>
                        <span>@Model.FinalAmount.ToString("#,##0") đ</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card mb-4 shadow-sm">
                <div class="card-header">
                    <i class="fas fa-table me-1"></i>
                    Danh sách sản phẩm
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Hình ảnh</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>@item.Product.Name</td>
                                    <td>
                                        <img src="~/product/@item.Product.ImageUrl" width="50" alt="@item.Product.Name" />
                                    </td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td>@item.Price.ToString("#,##0") đ</td>
                                    <td>@((item.Price * item.Quantity).ToString("#,##0")) đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>